<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{#if title}}{{title}} | {{/if}}TransSur</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">
    <link href="/stylesheets/admin.css" rel="stylesheet">
  </head>
  <body class="min-vh-100 bg-light">
    <header>
      <nav class="navbar navbar-dark admin-navbar">
        <div class="container py-2">
          <a class="navbar-brand admin-brand" href="/">
            <img src="/logo-transsur.svg" alt="TransSur" height="44">
          </a>
          <div class="d-flex align-items-center gap-3 ms-auto">
            {{#if sesionIniciada}}
             
              <span class="navbar-text text-white">
                <i class="fas fa-user me-1"></i>{{nombre}}
              </span>
               <a class="btn btn-outline-light btn-sm" href="/admin/login/logout">
                Cerrar sesión <i class="fas fa-sign-out-alt ms-1"></i>
              </a>
            
            {{/if}}
          </div>
        </div>
      </nav>
    </header>
    {{{body}}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
