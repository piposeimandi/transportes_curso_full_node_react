<div class="container py-5">
        <h1 class="h3 mb-4">Modificar novedad</h1>

        <form action="/admin/novedades/modificar" method="POST" enctype="multipart/form-data">
            {{#if error}}<div class="alert alert-danger" role="alert">{{error}}</div>{{/if}}
            <input type="hidden" name="id" value="{{novedad.id}}">

            <div class="mb-3">
                <label for="titulo" class="form-label">Título</label>
                <input type="text" class="form-control" id="titulo" name="titulo" maxlength="150" value="{{novedad.titulo}}" required>
            </div>

            <div class="mb-3">
                <label for="subtitulo" class="form-label">Subtítulo</label>
                <textarea class="form-control" id="subtitulo" name="subtitulo" rows="2" required>{{novedad.subtitulo}}</textarea>
            </div>

            <div class="mb-3">
                <label for="cuerpo" class="form-label">Cuerpo</label>
                <textarea class="form-control" id="cuerpo" name="cuerpo" rows="6" required>{{novedad.cuerpo}}</textarea>
            </div>

            <div class="mb-3">
                <label for="imagen" class="form-label">Reemplazar imagen (opcional)</label>
                <input type="file" class="form-control" id="imagen" name="imagen" accept=".jpg,.jpeg,.png,.gif,.webp">
                <div class="form-text">Formatos permitidos: JPG, PNG, GIF o WEBP. Máximo 5 MB.</div>
                {{#if novedad.imagen}}
                    <div class="mt-2">
                        <img src="/images/{{novedad.imagen}}" alt="Imagen actual de la novedad" class="img-thumbnail" style="max-width: 240px; max-height: 160px;">
                        <div class="small text-muted">Archivo: {{novedad.nombre_imagen}}</div>
                        <div class="form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="eliminar_imagen" name="eliminar_imagen" value="1">
                            <label class="form-check-label" for="eliminar_imagen">Eliminar imagen actual</label>
                        </div>
                    </div>
                {{/if}}
            </div>

            <button type="submit" class="btn btn-success">Guardar cambios <i class="fas fa-save"></i></button>
        </form>
    </div>
